rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // SUPPLIES Collection (FIXED: Read permission extended for RESERVED status)
    // =========================================================================
    match /supplies/{supplyId} {
      
      // FIX 1: Donor can read ALL their supplies (MyDonations page)
      allow read: if request.auth != null && 
                    request.auth.uid == resource.data.donorId;

      // FIX 2: Allow ANY authenticated user to read supplies that are 'available'
      // OR if they are 'reserved' (meaning a request was approved).
      allow read: if resource.data.status == 'available' || 
                      resource.data.status == 'reserved';

      // Only Donor can create new supplies
      allow create: if request.auth != null &&
                      request.auth.uid == request.resource.data.donorId;
                      
      // Only Donor can update or delete their supplies
      allow update, delete: if request.auth != null && 
                      request.auth.uid == resource.data.donorId;
    }
    
    // =========================================================================
    // REQUESTS Collection (No Change)
    // =========================================================================
    match /requests/{requestId} {
      allow read: if request.auth != null && 
                    (request.auth.uid == resource.data.receiverId || 
                     request.auth.uid == resource.data.donorId);
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.receiverId;
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.receiverId || 
                       request.auth.uid == resource.data.donorId);
      allow delete: if request.auth != null && 
                      request.auth.uid == resource.data.receiverId;
    }
    
    // =========================================================================
    // USERS Collection (No Change)
    // =========================================================================
    match /users/{userId} {
      allow create: if request.auth != null && 
                      request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && 
                           request.auth.uid == userId;
      allow read: if request.auth != null;
    }
  }
}